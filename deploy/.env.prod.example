# 复制为 deploy/.env.prod 并填入真实值；该文件已被 .gitignore 忽略，切勿提交。
# 生产密钥建议由 KMS / Secrets Manager 注入，此文件仅存放注入后的环境变量。
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=wanhui
DB_USERNAME=wanhui_app
DB_PASSWORD=change_me_db_password
FIELD_KEY_VERSION=1
FIELD_ENCRYPTION_KEY=replace_with_base64_32_bytes
FIELD_HMAC_KEY=replace_with_base64_32_bytes
APP_IMAGE_TAG=2026-11-26-1
FRONTEND_IMAGE_TAG=2026-11-26-1
LOG_LEVEL=INFO
